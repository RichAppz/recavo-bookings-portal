default_platform(:ios)

APP_STORE_CONNECT_API_KEY_ID      = "QLBXLNY339"
APP_STORE_CONNECT_API_ISSUER_ID   = "69a6de78-bc86-47e3-e053-5b8c7c11a4d1"
APP_STORE_CONNECT_API_KEY_PATH    = File.expand_path("~/.private_keys/AuthKey_QLBXLNY339.p8")

platform :ios do
  desc "Push a new build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: APP_STORE_CONNECT_API_KEY_ID,
      issuer_id: APP_STORE_CONNECT_API_ISSUER_ID,
      key_filepath: APP_STORE_CONNECT_API_KEY_PATH,
    )

    testflight_build = latest_testflight_build_number(api_key: api_key)
    local_build = get_build_number(xcodeproj: "ios/App/App.xcodeproj").to_i
    next_build = [testflight_build, local_build].max + 1

    # skip_info_plist: Info.plist reads $(CURRENT_PROJECT_VERSION); agvtool would
    # otherwise overwrite that with a literal and the two drift apart.
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: next_build,
      skip_info_plist: true,
    )

    cap_sync_production

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "fastlane/build",
      output_name: "RECAVO.ipa",
      clean: true,
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Build only (no upload) — useful for verifying the archive"
  lane :build do
    cap_sync_production

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "fastlane/build",
      output_name: "RECAVO.ipa",
      clean: true,
    )
  end
end

private_lane :cap_sync_production do
  Dir.chdir("..") do
    sh("CAP_ENV=production npx cap sync ios")
  end
end

# ---------------------------------------------------------------------------------
# Android → Google Play. The Play equivalent of TestFlight is the *internal testing*
# track: up to 100 testers, live within minutes, no review. Promote from there in the
# Play Console (or with `track_promote_to`) once a build is known good.
#
# Needs, outside the repo (see android/keystore.properties.example):
#   ~/.private_keys/recavo-upload.jks                    upload keystore
#   android/keystore.properties                          points Gradle at it
#   ~/.private_keys/recavo-play-service-account.json     Play Console API key
# ---------------------------------------------------------------------------------
PLAY_JSON_KEY_PATH = File.expand_path("~/.private_keys/recavo-play-service-account.json")
# Absolute: plain Ruby in a lane runs inside fastlane/, while action paths (below) are
# resolved from the repo root.
ANDROID_GRADLE_FILE = File.expand_path("../android/app/build.gradle", __dir__)
ANDROID_AAB_PATH = "android/app/build/outputs/bundle/release/app-release.aab"

platform :android do
  desc "Push a new build to the Play internal testing track"
  lane :internal do
    # Play rejects a versionCode it has seen on any track, so go one past the highest
    # anywhere — same idea as the TestFlight build number above.
    play_codes = %w[internal alpha beta production].flat_map do |track|
      google_play_track_version_codes(track: track, json_key: PLAY_JSON_KEY_PATH)
    rescue StandardError
      []
    end
    next_code = ([android_version_code] + play_codes).max + 1
    set_android_version_code(next_code)

    cap_sync_production_android

    gradle(task: "clean bundleRelease", project_dir: "android")

    upload_to_play_store(
      track: "internal",
      json_key: PLAY_JSON_KEY_PATH,
      aab: ANDROID_AAB_PATH,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end

  desc "Build a signed release bundle only (no upload) — for the first manual upload, or to check signing"
  lane :build do
    cap_sync_production_android
    gradle(task: "clean bundleRelease", project_dir: "android")
    UI.success("Bundle: #{ANDROID_AAB_PATH}")
  end
end

private_lane :cap_sync_production_android do
  Dir.chdir("..") do
    sh("CAP_ENV=production npx cap sync android")
  end
end

def android_version_code
  File.read(ANDROID_GRADLE_FILE)[/^\s*versionCode\s+(\d+)/, 1].to_i
end

def set_android_version_code(code)
  gradle = File.read(ANDROID_GRADLE_FILE)
  File.write(ANDROID_GRADLE_FILE, gradle.sub(/^(\s*versionCode\s+)\d+/, "\\1#{code}"))
  UI.message("versionCode → #{code}")
end
