# Copy to android/keystore.properties (gitignored) and fill in. This is the Play
# *upload* key: Google holds the real app signing key (Play App Signing), so if this
# one is ever lost it can be reset from the Play Console — but keep it safe anyway.
#
# Create the keystore once, outside the repo:
#   keytool -genkeypair -v -keystore ~/.private_keys/recavo-upload.jks \
#     -alias recavo-upload -keyalg RSA -keysize 2048 -validity 10000
storeFile=/Users/you/.private_keys/recavo-upload.jks
storePassword=
keyAlias=recavo-upload
keyPassword=
