# Staging build target for the Cloudflare Worker (vite build --mode staging).
#
# Every value here is compiled into the client bundle and is public by design:
# the Supabase key is the anon/publishable one, guarded by row-level security.
# Never put a service-role key or any server secret in this file.
#
# Staging runs on its own Supabase project so that a test sign-up or booking
# can never reach a real customer. Fill these in from that project's
# Settings → API once it exists; they must NOT match production.

VITE_API_BASE_URL=https://staging-booking-api.recavo.app
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
