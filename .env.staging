# Staging build target for the Cloudflare Worker (vite build --mode staging).
#
# Every value here is compiled into the client bundle and is public by design:
# the Supabase key is the anon/publishable one, guarded by row-level security.
# Never put a service-role key or any server secret in this file.
#
# This is the only environment that exists today. It points at the
# `recavo-staging` Supabase project, the same one local development uses, so a
# booking made here is visible on localhost and vice versa.

# TEMPORARY: Fly's own hostname, not staging-booking-api.recavo.app.
#
# The custom domain's certificate is provisioned but its CNAME still points at a
# Fly app that no longer exists, so the name does not resolve and every request
# from the browser fails as an opaque "Failed to fetch". Switch this back once
# `fly certs list -a recavo-api-t06q8q` shows the hostname verified, and redeploy.
VITE_API_BASE_URL=https://recavo-api-t06q8q.fly.dev
VITE_SUPABASE_URL=https://llxyiqfmbjjgbpacbnol.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxseHlpcWZtYmpqZ2JwYWNibm9sIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU1MDMyNzEsImV4cCI6MjEwMTA3OTI3MX0.rBXBhUSt9g3L1lXpxLLm2RySvn7rUbdBACx2-8ogutQ
