{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RECAVO",
  "version": "0.1.0",
  "identifier": "com.richappz.recavo.desktop",
  "build": {
    "devUrl": "https://staging.bookings.recavo.app",
    "frontendDist": "https://staging.bookings.recavo.app"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Business",
    "shortDescription": "RECAVO bookings and business management",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["com.richappz.recavo"]
      }
    }
  }
}
