# Production build target for the Cloudflare Worker (vite build --mode production).
#
# Every value here is compiled into the client bundle and is public by design:
# the Supabase key is the anon/publishable one, guarded by row-level security.
# Never put a service-role key or any server secret in this file.
#
# Must be the production Supabase project (`fly.production.toml` SUPABASE_URL is
# https://lcciokzqvatsrckmirdm.supabase.co). Staging is llxyiqfmbjjgbpacbnol — a
# leftover staging URL here would boot and send production logins to the staging
# identity provider.
#
# The URL is the project's custom auth domain, which proxies that same project
# (Supabase → Project Settings → General → Custom domains). The API keeps the
# .supabase.co URL because the JWT issuer never changes to the custom domain.
# VITE_SUPABASE_PROJECT_REF keeps the browser session key the project URL would
# have produced, so switching domains does not sign everyone out.

VITE_API_BASE_URL=https://booking-api.recavo.app
VITE_SUPABASE_URL=https://auth.recavo.app
VITE_SUPABASE_PROJECT_REF=lcciokzqvatsrckmirdm
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxjY2lva3pxdmF0c3Jja21pcmRtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc5OTc1ODEsImV4cCI6MjEwMzU3MzU4MX0.6QLi0mfL8AXRiMonDIm5sF3uoeAt3pmvF-eFSFBSJyE
# RevenueCat public SDK keys (RevenueCat → Project → Apps): Apple app (appl_…) for iOS,
# Google Play app (goog_…) for Android. Leave the Android key empty until the Play
# products exist — the Android app then shows plan state only.
VITE_REVENUECAT_IOS_API_KEY=appl_tNxyWZHidfgandMrcLwbwYakMve
VITE_REVENUECAT_ANDROID_API_KEY=goog_XtFgPCifDmBWrsKSUwqxtiqbtYK
