# RECAVO API (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000
# The API must have SAAS_BILLING_CHECKOUT_ENABLED=true, SAAS_BILLING_REQUIRE_SUBSCRIPTION=true,
# and PUBLIC_APP_URL (or BILLING_SUCCESS_URL / BILLING_CANCEL_URL) pointing at this portal.

# Supabase Auth (Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# In-App Purchase (store apps only). RevenueCat *public* SDK keys: the Apple app's
# (starts appl_) for iOS, the Google Play app's (starts goog_) for Android. Unset = that
# store app cannot sell and shows plan state only.
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=
