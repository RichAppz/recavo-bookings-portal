# Env
.env
.env.*
!.env.example
# Deploy targets are tracked: every VITE_* value is compiled into the client
# bundle and served to anyone who loads the page, so none of it can be secret,
# and keeping it here means a deploy does not depend on one laptop's files.
!.env.production
!.env.staging

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
