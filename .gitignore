# Env
.env
.env.*
!.env.example
# Deploy targets are tracked: every VITE_* value is compiled into the client
# bundle and served to anyone who loads the page, so none of it can be secret,
# and keeping it here means a deploy does not depend on one laptop's files.
!.env.production
!.env.staging

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Capacitor / native mobile build artifacts (the ios/ and android/ projects are
# tracked, but generated build output and dependencies are not)
ios/App/Pods/
ios/App/App/public/
ios/DerivedData/
android/.gradle/
android/app/build/
android/build/
android/app/src/main/assets/public/
android/local.properties
android/capacitor-cordova-android-plugins/

# Android release signing. The upload keystore and its passwords live outside the
# repo (~/.private_keys, like the App Store Connect key); keystore.properties only
# points at them. Losing control of the key means losing the Play listing.
android/keystore.properties
*.jks
*.keystore
android/app/release/
# Play Console service account key for fastlane supply
fastlane/*.json

# Fastlane
fastlane/build/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Bundler
vendor/bundle/
.bundle/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
