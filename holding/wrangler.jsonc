{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recavo-holding",
  "main": "worker.js",
  "compatibility_date": "2026-08-28",
  // dashboard.recavo.app stays on the holding page. book.recavo.app and
  // bookings.recavo.app are the live production Worker (recavo-portal).
  "routes": [
    { "pattern": "dashboard.recavo.app", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
